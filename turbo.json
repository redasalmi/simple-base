{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {
      "outputs": []
    },
    "//#format:fix": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@simple-base/solid#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "solid-playground#dev": {
      "dependsOn": ["^build"],
      "with": ["@simple-base/solid#dev"],
      "cache": false,
      "persistent": true
    }
  }
}
