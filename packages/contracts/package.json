{
  "name": "@simple-base/contracts",
  "version": "0.18.0",
  "description": "Framework-neutral component options and defaults shared by Simple Base adapters.",
  "keywords": [
    "components",
    "contracts",
    "design-system",
    "simple-base",
    "types"
  ],
  "homepage": "https://github.com/redasalmi/simple-base/tree/main/packages/contracts#readme",
  "bugs": {
    "url": "https://github.com/redasalmi/simple-base/issues"
  },
  "license": "MIT",
  "author": "Reda Salmi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redasalmi/simple-base.git",
    "directory": "packages/contracts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "default": "./dist/badge.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "default": "./dist/card.js"
    },
    "./combobox": {
      "types": "./dist/combobox.d.ts",
      "default": "./dist/combobox.js"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "default": "./dist/date-picker.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "default": "./dist/dialog.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "default": "./dist/field.js"
    },
    "./fieldset": {
      "types": "./dist/fieldset.d.ts",
      "default": "./dist/fieldset.js"
    },
    "./listbox": {
      "types": "./dist/listbox.d.ts",
      "default": "./dist/listbox.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "default": "./dist/menu.js"
    },
    "./number-field": {
      "types": "./dist/number-field.d.ts",
      "default": "./dist/number-field.js"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "default": "./dist/pagination.js"
    },
    "./placement": {
      "types": "./dist/placement.d.ts",
      "default": "./dist/placement.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "default": "./dist/select.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "default": "./dist/status.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "default": "./dist/tabs.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "default": "./dist/tooltip.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@internationalized/date": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.4"
  }
}
