      "$description": "Raw simple-base-light palette. Product components must not reference this group directly.",
      "canvas": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.964706, 0.968627, 0.972549],
          "hex": "#f6f7f8"
        }
      },
      "surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
