{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "catppuccin-latte color theme.",
  "$extensions": {
    "org.simple-base.theme": {
      "colorScheme": "light",
      "palette": {
        "name": "Catppuccin Latte",
        "source": "https://catppuccin.com/palette",
        "colors": {
          "rosewater": "#dc8a78",
          "flamingo": "#dd7878",
          "pink": "#ea76cb",
          "mauve": "#8839ef",
          "red": "#d20f39",
          "maroon": "#e64553",
          "peach": "#fe640b",
          "yellow": "#df8e1d",
          "green": "#40a02b",
          "teal": "#179299",
          "sky": "#04a5e5",
          "sapphire": "#209fb5",
          "blue": "#1e66f5",
          "lavender": "#7287fd",
          "text": "#4c4f69",
          "subtext1": "#5c5f77",
          "subtext0": "#6c6f85",
          "overlay2": "#7c7f93",
          "overlay1": "#8c8fa1",
          "overlay0": "#9ca0b0",
          "surface2": "#acb0be",
          "surface1": "#bcc0cc",
          "surface0": "#ccd0da",
          "base": "#eff1f5",
          "mantle": "#e6e9ef",
          "crust": "#dce0e8"
        }
      }
    }
  },
  "primitive": {
    "shadow": {
      "$type": "shadow",
      "overlay": {
        "$description": "Soft elevation for overlays on light surfaces.",
        "$value": {
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 16,
            "unit": "px"
          },
          "blur": {
            "value": 40,
            "unit": "px"
          },
          "spread": {
            "value": -16,
            "unit": "px"
          },
          "color": {
            "colorSpace": "srgb",
            "components": [0.298039, 0.309804, 0.411765],
            "alpha": 0.28
          }
        }
      }
    },
    "color": {
      "$type": "color",
      "$description": "Raw Catppuccin Latte palette colors; each token names the palette color it uses. Product components must not reference this group directly.",
      "bg-canvas": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.937255, 0.945098, 0.960784]
        },
        "$extensions": {
          "org.simple-base.palette": "base"
        }
      },
      "bg-surface": {
