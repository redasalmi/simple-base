            "$value": "{primitive.color.warning}"
          },
          "surface": {
            "$value": "{primitive.color.warning-surface}"
          },
          "text": {
            "$value": "{primitive.color.warning-text}"
          },
          "on-surface": {
            "$value": "{primitive.color.warning-on}"
          },
          "soft": {
            "$value": "{primitive.color.warning-soft}"
          }
