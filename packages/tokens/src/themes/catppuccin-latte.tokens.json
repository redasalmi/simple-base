  "semantic": {
    "color": {
      "$description": "Theme-resolved color roles. This group is the only color API consumed by components.",
      "background": {
        "$type": "color",
        "canvas": {
          "$value": "{primitive.color.canvas}"
        },
        "surface": {
          "$value": "{primitive.color.surface}"
        },
        "raised": {
          "$value": "{primitive.color.raised}"
        },
        "overlay": {
          "$value": "{primitive.color.overlay}"
        },
        "subtle": {
          "$value": "{primitive.color.bg-subtle}"
        }
      },
      "foreground": {
        "$type": "color",
        "primary": {
          "$value": "{primitive.color.fg}"
        },
        "secondary": {
          "$value": "{primitive.color.secondary}"
        },
        "muted": {
          "$value": "{primitive.color.muted}"
        },
        "subtle": {
          "$value": "{primitive.color.fg-subtle}"
        },
        "inverse": {
          "$value": "{primitive.color.inverse}"
        }
      },
      "border": {
