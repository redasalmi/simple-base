        "$type": "color",
        "background": {
          "$value": "{primitive.color.accent}"
        },
        "foreground": {
          "$value": "{primitive.color.inverse}"
        }
      },
      "focus": {
        "$type": "color",
        "ring": {
          "$value": "{primitive.color.accent-readable}"
        },
        "danger-ring": {
          "$value": "{primitive.color.danger}"
        }
      },
      "overlay": {
        "$type": "color",
        "scrim": {
          "$value": "{primitive.color.scrim}"
