{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Opacity, layering, and shadow tokens.",
  "primitive": {
    "opacity": {
      "$type": "number",
      "disabled": {
        "$value": 0.48
      },
      "subtle": {
        "$value": 0.72
      },
      "invisible": {
        "$value": 0
      },
      "opaque": {
        "$value": 1
      }
    },
    "z-index": {
      "$type": "number",
      "base": {
        "$value": 0
      },
      "sticky": {
        "$value": 200
      },
      "dropdown": {
        "$value": 400
      },
      "overlay": {
        "$value": 600
      },
      "modal": {
        "$value": 700
      },
      "toast": {
        "$value": 900
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$description": "A 1px baseline under the card edge; depth comes from edges, not blur.",
        "$value": {
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.06
          }
        }
      },
      "overlay": {
        "$description": "Soft elevation reserved for overlays; light themes override this shadow.",
        "$value": {
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 16,
            "unit": "px"
          },
          "blur": {
            "value": 40,
            "unit": "px"
          },
          "spread": {
            "value": -12,
            "unit": "px"
          },
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.5
          }
        }
      }
    }
  }
}
