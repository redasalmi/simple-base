{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Typography primitives and stable semantic roles.",
  "primitive": {
    "font-family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "sans-serif"
        ]
      },
      "display": {
        "$value": ["Iowan Old Style", "Charter", "Georgia", "Times New Roman", "serif"]
      },
      "mono": {
        "$value": [
          "Geist Mono",
          "Berkeley Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Monaco",
          "Consolas",
          "monospace"
        ]
      }
    },
    "font-weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "font-size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 11,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "2xl": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "3xl": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "4xl": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "5xl": {
        "$value": {
          "value": 48,
          "unit": "px"
        }
      },
      "display": {
        "$value": {
          "value": 64,
          "unit": "px"
        }
      }
    },
    "line-height": {
      "$type": "number",
      "none": {
        "$value": 1
      },
      "tight": {
        "$value": 1.08
      },
      "snug": {
        "$value": 1.2
      },
      "normal": {
        "$value": 1.4
      },
      "relaxed": {
        "$value": 1.55
      }
    },
    "letter-spacing": {
      "$type": "number",
      "tight": {
        "$value": -0.06,
        "$description": "Relative em value."
      },
      "snug": {
        "$value": -0.03,
        "$description": "Relative em value."
      },
      "normal": {
        "$value": -0.01,
        "$description": "Relative em value."
      },
      "wide": {
        "$value": 0.04,
        "$description": "Relative em value."
      },
      "wider": {
        "$value": 0.08,
        "$description": "Relative em value."
      }
    }
  }
}
