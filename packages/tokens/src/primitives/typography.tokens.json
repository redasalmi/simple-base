{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Typography primitives.",
  "primitive": {
    "font-family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Atkinson Hyperlegible Next",
          "Atkinson Hyperlegible",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "sans-serif"
        ]
      },
      "display": {
        "$value": ["Young Serif", "Iowan Old Style", "Charter", "Georgia", "serif"]
      },
      "mono": {
        "$value": [
          "Atkinson Hyperlegible Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Monaco",
          "Consolas",
          "monospace"
        ]
      }
    },
    "font-weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "font-size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "md": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "lg": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "xl": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "2xl": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "3xl": {
        "$value": {
          "value": 1.75,
          "unit": "rem"
        }
      },
      "4xl": {
        "$value": {
          "value": 2.25,
          "unit": "rem"
        }
      },
      "5xl": {
        "$value": {
          "value": 3.25,
          "unit": "rem"
        }
      },
      "display": {
        "$value": {
          "value": 4.5,
          "unit": "rem"
        }
      }
    },
    "line-height": {
      "$type": "number",
      "none": {
        "$value": 1
      },
      "tight": {
        "$value": 1.05
      },
      "snug": {
        "$value": 1.2
      },
      "normal": {
        "$value": 1.45
      },
      "relaxed": {
        "$value": 1.55
      }
    },
    "letter-spacing": {
      "$type": "number",
      "$description": "Letter spacing in em, relative to the font size. The CSS output adds the em unit; other outputs keep the plain number.",
      "tight": {
        "$value": -0.03
      },
      "snug": {
        "$value": -0.02
      },
      "normal": {
        "$value": 0
      },
      "wide": {
        "$value": 0.02
      },
      "wider": {
        "$value": 0.06
      }
    }
  }
}
