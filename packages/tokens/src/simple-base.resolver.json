{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Simple Base",
  "description": "Primitive, semantic, and theme tokens with selectable color themes.",
  "version": "2025.10",
  "resolutionOrder": [
    {
      "$ref": "#/sets/primitives"
    },
    {
      "$ref": "#/sets/semantic"
    },
    {
      "$ref": "#/modifiers/theme"
    }
  ],
  "sets": {
    "primitives": {
      "description": "Foundational token values.",
      "sources": [
        {
          "$ref": "primitives/effects.tokens.json"
        },
        {
          "$ref": "primitives/motion.tokens.json"
        },
        {
          "$ref": "primitives/sizing.tokens.json"
        },
        {
          "$ref": "primitives/typography.tokens.json"
        }
      ]
    },
    "semantic": {
      "description": "Stable semantic token roles.",
      "sources": [
        {
          "$ref": "semantic/effects.tokens.json"
        },
        {
          "$ref": "semantic/motion.tokens.json"
        },
        {
          "$ref": "semantic/sizing.tokens.json"
        },
        {
          "$ref": "semantic/typography.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "Color theme.",
      "default": "simple-base-dark",
      "contexts": {
        "simple-base-dark": [
          {
            "$ref": "themes/simple-base-dark.tokens.json"
          },
          {
            "$ref": "semantic/color.tokens.json"
          }
        ],
        "simple-base-light": [
          {
            "$ref": "themes/simple-base-light.tokens.json"
          },
          {
            "$ref": "semantic/color.tokens.json"
          }
        ],
        "catppuccin-latte": [
          {
            "$ref": "themes/catppuccin-latte.tokens.json"
          },
          {
            "$ref": "semantic/color.tokens.json"
          }
        ],
        "catppuccin-frappe": [
          {
            "$ref": "themes/catppuccin-frappe.tokens.json"
          },
          {
            "$ref": "semantic/color.tokens.json"
          }
        ],
        "catppuccin-macchiato": [
          {
            "$ref": "themes/catppuccin-macchiato.tokens.json"
          },
          {
            "$ref": "semantic/color.tokens.json"
          }
        ],
        "catppuccin-mocha": [
          {
            "$ref": "themes/catppuccin-mocha.tokens.json"
          },
          {
            "$ref": "semantic/color.tokens.json"
          }
        ],
        "dracula": [
          {
            "$ref": "themes/dracula.tokens.json"
          },
          {
            "$ref": "semantic/color.tokens.json"
          }
        ],
        "tokyo-night": [
          {
            "$ref": "themes/tokyo-night.tokens.json"
          },
          {
            "$ref": "semantic/color.tokens.json"
          }
        ],
        "nord": [
          {
            "$ref": "themes/nord.tokens.json"
          },
          {
            "$ref": "semantic/color.tokens.json"
          }
        ]
      }
    }
  }
}
