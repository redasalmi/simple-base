{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Motion timing and easing tokens.",
  "semantic": {
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": "{primitive.duration.fast}"
        },
        "normal": {
          "$value": "{primitive.duration.normal}"
        },
        "slow": {
          "$value": "{primitive.duration.slow}"
        },
        "loop": {
          "$description": "One cycle of a repeating animation, such as an indeterminate progress bar.",
          "$value": "{primitive.duration.loop}"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "out": {
          "$value": "{primitive.easing.out}"
        },
        "standard": {
          "$value": "{primitive.easing.standard}"
        }
      },
      "scale": {
        "$type": "number",
        "pressed": {
          "$description": "Scale of a control while it is pressed.",
          "$value": "{primitive.scale.pressed}"
        },
        "enter": {
          "$description": "Starting scale of a popup as it appears.",
          "$value": "{primitive.scale.enter}"
        }
      }
    }
  }
}
