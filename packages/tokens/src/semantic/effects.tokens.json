{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Opacity, layering, and shadow tokens.",
  "semantic": {
    "opacity": {
      "$type": "number",
      "disabled": {
        "$value": "{primitive.opacity.disabled}"
      },
      "subtle": {
        "$value": "{primitive.opacity.subtle}"
      }
    },
    "layer": {
      "$type": "number",
      "sticky": {
        "$value": "{primitive.z-index.sticky}"
      },
      "dropdown": {
        "$value": "{primitive.z-index.dropdown}"
      },
      "tooltip": {
        "$value": "{primitive.z-index.tooltip}"
      },
      "toast": {
        "$value": "{primitive.z-index.toast}"
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": "{primitive.shadow.card}"
      },
      "overlay": {
        "$value": "{primitive.shadow.overlay}"
      }
    }
  }
}
