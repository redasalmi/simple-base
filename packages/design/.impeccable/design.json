  "narrative": {
    "northStar": "Chromatic Command Center",
    "overview": "Simple Base feels like a precision instrument energized by color. Its compact structure comes from Linear; its tactile controls, luminous atmosphere, and layered depth come from Raycast. The result is professional product UI that feels alive rather than ornamental. The component grammar stays stable while nine themes reinterpret its colors.",
    "keyCharacteristics": [
      "Compact, task-focused information density",
      "Vibrant accents reserved for action and state",
      "Ambient light paired with structural surface layers",
      "Tactile controls with crisp focus and press feedback",
      "One recognizable component language across every theme"
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Every theme maps semantic roles; components never style against a theme name directly.",
        "section": "colors"
      },
      {
        "name": "The Rare Signal Rule",
        "body": "Accent color belongs to primary actions, current selection, focus, and semantic state, not decoration.",
        "section": "colors"
      },
      {
        "name": "The Product Scale Rule",
        "body": "Application typography uses fixed sizes and a tight hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Layer Before Glow Rule",
        "body": "A component remains legible through surface, border, and hierarchy before glow is added.",
        "section": "elevation"
      },
      {
        "name": "The Complete State Rule",
        "body": "Every public interactive component ships every applicable interaction and system state.",
        "section": "components"
      }
    ],
    "dos": [
      "Do build every component from semantic --sb-* roles so all nine themes remain coherent.",
      "Do reserve each theme's primary accent for action, selection, and focus.",
      "Do meet WCAG 2.2 AA in every theme."
    ],
    "donts": [
      "Don't make Simple Base look like another generic shadcn component library.",
      "Don't let community themes change component structure or behavior.",
      "Don't use glassmorphism as the default card language.",
      "Don't communicate state through color alone."
    ]
  }
}
