{
  "name": "@simple-base/solid",
  "version": "0.23.0",
  "description": "Accessible SolidJS components for Simple Base, built on native elements and Zag.",
  "keywords": [
    "accessibility",
    "components",
    "design-system",
    "simple-base",
    "solid",
    "solidjs",
    "zag"
  ],
  "homepage": "https://github.com/redasalmi/simple-base/tree/main/packages/solid#readme",
  "bugs": {
    "url": "https://github.com/redasalmi/simple-base/issues"
  },
  "license": "MIT",
  "author": "Reda Salmi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redasalmi/simple-base.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && node scripts/check-dist.js",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simple-base/contracts": "workspace:^",
    "@zag-js/combobox": "catalog:",
    "@zag-js/date-picker": "catalog:",
    "@zag-js/menu": "catalog:",
    "@zag-js/number-input": "catalog:",
    "@zag-js/select": "catalog:",
    "@zag-js/solid": "catalog:",
    "@zag-js/tabs": "catalog:",
    "@zag-js/toast": "catalog:",
    "@zag-js/tooltip": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@internationalized/date": "catalog:",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "rolldown-plugin-solid": "^0.2.1",
    "solid-js": "catalog:",
    "tsdown": "catalog:",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.4",
    "solid-js": "^1.9.15"
  }
}
