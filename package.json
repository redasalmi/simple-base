{
  "name": "simple-base",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "turbo run check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "quality": "turbo run check //#lint //#format",
    "quality:fix": "turbo run //#lint:fix //#format:fix"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.12",
    "typescript": "~7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
