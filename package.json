{
  "name": "simple-base",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "turbo run check typecheck",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:smoke": "turbo run build --filter=./packages/* && node scripts/smoke/run.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "quality": "turbo run check typecheck //#lint //#format",
    "quality:fix": "turbo run //#lint:fix //#format:fix"
  },
  "devDependencies": {
    "eslint-plugin-solid": "^0.18.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
